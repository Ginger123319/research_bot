# chart-deep-v5-2-235B — 8× H20 部署配置
# 生成时间: 2026-03-26

# ── 模型信息 ─────────────────────────────────────────────────────
MODEL_NAME="chart_deep_v5-2_235B_chart_deep"   # 用于日志目录命名
MODEL_SHORT="chart-deep-v5-2"                   # 脚本/实验命名
TOKENIZER="/mnt/ai-llm/chart/chart_deep/v5-2_235B_chart_deep"
SERVER_URL="http://172.21.65.228:8080/v1/chat/completions"

# ── 数据集 ───────────────────────────────────────────────────────
DATASET_PATH="datas/output_chart-deep-v5/combined_extracted.csv"    # Phase 1 & 2/3 全量（5621行）
DATASET_PEAK="datas/output_chart-deep-v5/chart_deep_v5-2_235B_poisson_100_stitched.csv"  # 峰值回放（1755行）

# ── Phase 0 输入/输出分布（来自 deep-chat-replay rate=1 RPS 实测）────
AVG_INPUT_LEN=3224       # tokens，p90=3769
AVG_OUTPUT_LEN=1006      # tokens，p90=1216；用于 DURATION/COOLDOWN/NUM_REQUESTS 推算
EST_E2E=58.8             # 低负载下 E2E 均值（秒），用于 Phase 1 NUM_REQUESTS 推算

# ── 时长与冷却（由 avg_output_len 公式推算）──────────────────────
DURATION_SECS=2520       # max(300, int(1006×2.5))=2515 → 取整 2520（约 42min/档）
COOLDOWN_SECS=510        # max(60, int(1006/2))=503 → 取整 510（约 8.5min）

# ── Phase 1 ──────────────────────────────────────────────────────
INIT_CON=60              # Little's Law 估算：1 RPS × 58.8s ≈ 59 并发，从 60 起跳

# ── Phase 2/3 ────────────────────────────────────────────────────
PRODUCTION_RPS=0.5       # 保守托底（30 RPM）；实际上线 RPM 确认后可更新
MAX_COMPLETION_TOKENS=4096
TTFS_P90_LIMIT=1.5       # SLA: TTFS P90 ≤ 1500ms
E2E_P90_LIMIT=150.0      # SLA: E2E P90 ≤ 150s
