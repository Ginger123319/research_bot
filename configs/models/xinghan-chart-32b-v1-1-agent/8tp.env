# ══════════════════════════════════════════════════════════════
# xinghan-chart-32b-v1-1-agent  8TP 部署配置
# 生成时间: 2026-03-18
# 设计规范: clingo/docs/designs/2026-03-18-generic-benchmark-runner-design.md
# ══════════════════════════════════════════════════════════════

# ── 模型基础 ──────────────────────────────────────────────────
MODEL_NAME="xinghan-chart-32b-v1-1-agent"
MODEL_PATH="/mnt/ai-llm/chartv5"
TOKENIZER="/mnt/ai-llm/chartv5"

# ── 数据处理 ──────────────────────────────────────────────────
DATA_FORMAT="indexed"          # ⚠️ 非标 standard：chart JSONL 是索引文件，需先下载 raw_content
INPUT_JSONL="datas/xinghan-chart-32b-v1-1-agent_260312_260316.jsonl"
OUTPUT_DIR="datas/output_chart"
MODEL_LIST="xinghan-chart-32b-v1-1-agent,星盘普通"
DATASET_PATH="datas/output_chart/xinghan-chart-32b-v1-1-agent_all.csv"
DATASET_TYPE="all"             # QPS sweep 用全量数据，无需峰值采样
TARGET_PEAK_RPM=""             # all 类型留空

# ── Benchmark 公共参数 ─────────────────────────────────────────
SERVER_URL="https://infer.geniuworks.com/infra-xinghan-chart-p32b-v1-agent/v1/chat/completions"
GROUP_NAME="chart-32b-8tp"
MAX_COMPLETION_TOKENS=4096     # 推理模型长输出场景
COOLDOWN_SECS=90

# ── QPS Sweep 参数 ─────────────────────────────────────────────
QPS_START=2.0
QPS_END=4.0
NUM_LEVELS=20
DURATION=1500                  # ⚠️ 非标 2700s：数据集仅 6016 条，QPS_END×2700=10800 超限

# ── Replay 参数 ────────────────────────────────────────────────
REPLAY_DATASET_PATH="datas/output_chart/xinghan-chart-32b-v1-1-agent_selected_combined_3days_peak_poisson_118_stitched.csv"
REPLAY_RPM="118"
