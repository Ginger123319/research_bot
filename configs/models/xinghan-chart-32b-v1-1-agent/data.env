# xinghan-chart-32b-v1-1-agent 数据处理配置
#
# 用法：
#   python scripts/data/process.py --env configs/models/xinghan-chart-32b-v1-1-agent/data.env
#
# 产出：
#   datas/output_chart/xinghan-chart-32b-v1-1-agent_full.csv
#   (~47,029 行 = 6,016 直接调用 + 41,013 Agent 重建)
#
# 注：indexed 模式下 downloaded_raw.jsonl 已存在（739MB），Stage 1 会自动跳过下载。

DATA_FORMAT=indexed

MODEL_NAME=xinghan-chart-32b-v1-1-agent

# 直接调用模型（prompt 内联，6,016 条）
MODEL_LIST=xinghan-chart-32b-v1-1-agent

# Agent 框架调用（prompt 为空，从 role=ib 星盘档案重建，~41,013 条）
AGENT_MODEL_LIST=星盘普通

INPUT_JSONL=datas/xinghan-chart-32b-v1-1-agent_260312_260316.jsonl
OUTPUT_DIR=datas/output_chart

# 已有下载文件的路径（739MB，跳过 Stage 1 重新下载）
DOWNLOADED_RAW_PATH=datas/xinghan-chart-32b-v1-1-agent_downloaded_raw.jsonl

# 下载并发数（仅在需要重新下载时生效）
NUM_WORKERS=128

# benchmark 使用的最终数据集（直接调用 + Agent 重建）
DATASET_PATH=datas/output_chart/xinghan-chart-32b-v1-1-agent_full.csv
