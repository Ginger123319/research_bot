# ══════════════════════════════════════════════════════════════
# xinghan-guoxue-72b-v1-2-reason  4×H20 评估配置（V2 真实线上数据）
# 生成时间: 2026-03-20
# 与 8tp_v2.env 的差异：4×H20 部署，endpoint 和模型 ID 不同
#   H20 吞吐先验：5× L20（单卡），4H20 vs 8L20 总吞吐 ≈ 2.5×
#   Phase 1 起始并发: 60（L20 饱和 con=30 × 2.5 = 75，取保守 60）
# ══════════════════════════════════════════════════════════════

# ── 模型基础 ──────────────────────────────────────────────────
MODEL_NAME="infra-xinghan-guoxue-p72b-v12-reason"
TOKENIZER="/mnt/ai-llm/l83v2-G1-400"

# ── 远端服务 ──────────────────────────────────────────────────
SERVER_URL="https://infer.geniuworks.com/infra-xinghan-guoxue-p72b-v12-reason/v1/chat/completions"
# API Key: 无需（公开端点）

# ── 数据处理 ──────────────────────────────────────────────────
DATA_FORMAT="standard"
DATASET_PATH="datas/output_guoxue_v2/xinghan-guoxue-72b-v1-2-reason_selected_combined_2days_peak_poisson_256_stitched.csv"
TARGET_PEAK_RPM=256

# ── SLA 阈值（V2）────────────────────────────────────────────
TTFS_P90_LIMIT=1.5        # 1500ms
E2E_P90_LIMIT=180.0       # 180s
SUCCESS_RATE=0.99

# ── Benchmark 公共参数 ─────────────────────────────────────────
MAX_COMPLETION_TOKENS=4096

# ── QPS Peak Finder 参数 ──────────────────────────────────────
PRODUCTION_RPS=0.05       # 安全下限（H20 首次部署，无 Grafana 生产数据）

# Phase 1
PHASE1_INIT_CON=60        # 先验：H20 5×L20 × 4GPU/8GPU = 2.5× → 饱和点约 75，取 60 起跳
PHASE1_TIME_LIMIT=300     # 5min/档

# Phase 2
PHASE2_DURATION=3600      # 1h/档（avg_output_len ≈ 1386 → max(1200, 1386×2.5=3465) → 取 3600）
PHASE2_COOLDOWN=900       # 15min 冷却（E2E P90 ~300s 模型，需充分排空）

# Phase 3
PHASE3_DURATION=3600      # 1h/档（与 Phase 2 对齐）
PHASE3_COOLDOWN=900       # 15min 冷却

# ── 回放测试参数（6×4xH20 + 4×8xL20 混合部署，统一入口）─────────
GROUP_NAME="guoxue-72b-mixed-10inst"   # 部署组标识：6×H20 + 4×L20 共 10 实例
REPLAY_DATASET_PATH="datas/output_guoxue_v2/xinghan-guoxue-72b-v1-2-reason_selected_combined_2days_peak_poisson_256_stitched.csv"
REPLAY_RPM="256"          # 业务峰值目标 RPM（Grafana 实测 213+43）
