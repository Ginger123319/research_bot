# ══════════════════════════════════════════════════════════════
# xinghan-guoxue-72b-v1-2-reason  V2 评估配置（真实线上数据）
# 生成时间: 2026-03-20
# 与 V1 的差异：真实线上数据 + 更新 SLA（e2e P90 < 180s）
# ══════════════════════════════════════════════════════════════

# ── 模型基础 ──────────────────────────────────────────────────
MODEL_NAME="xinghan-guoxue-72b-v1-2-reason"
TOKENIZER="/mnt/ai-llm/l83v2-G1-400"

# ── 远端服务 ──────────────────────────────────────────────────
SERVER_URL="https://infer-test.geniuworks.com/bazi-guoxue-eagle3-test/v1/chat/completions"
# API Key: 无需（公开端点）

# ── 数据处理 ──────────────────────────────────────────────────
DATA_FORMAT="standard"
INPUT_JSONL="/home/ceceadmin/wnd/workspace/repo/SpecForge/wnd_dev/data/downloaded/guoxue-v1-2-online-2026-01-1631-downloaded-s50k.jsonl"
OUTPUT_DIR="datas/output_guoxue_v2"
MODEL_LIST="xinghan-guoxue-72b-v1-2-reason,八字深度"
DATASET_PATH="datas/output_guoxue_v2/xinghan-guoxue-72b-v1-2-reason_selected_combined_2days_peak_poisson_256_stitched.csv"
DATASET_TYPE="peak"
TARGET_PEAK_RPM=256

# ── SLA 阈值（v2 更新）────────────────────────────────────────
TTFS_P90_LIMIT=1.5        # 1500ms
E2E_P90_LIMIT=180.0       # 180s（V1 为 150s）
SUCCESS_RATE=0.99

# ── Benchmark 公共参数 ─────────────────────────────────────────
MAX_COMPLETION_TOKENS=4096
COOLDOWN_SECS=60

# ── QPS Peak Finder 参数 ──────────────────────────────────────
PRODUCTION_RPM=256        # Grafana 峰值 213+43 RPM
PRODUCTION_RPS=4.27       # = 256 / 60

# Phase 1
PHASE1_INIT_CON=5         # 无先验并发数，从 con=5 开始
PHASE1_TIME_LIMIT=300     # 5min/档

# Phase 2
PHASE2_DURATION=1200      # 20min/档

# Phase 3
PHASE3_DURATION=2700      # 45min/档
