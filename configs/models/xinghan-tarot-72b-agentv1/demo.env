# ══════════════════════════════════════════════════════════════
# xinghan-tarot-72b-agentv1  Demo 部署配置
# 生成时间: 2026-03-30
# Pulsar 平台 demo 部署，endpoint 由用户提供
# ══════════════════════════════════════════════════════════════

# ── 模型基础 ──────────────────────────────────────────────────
MODEL_NAME="xinghan-tarot-72b-agentv1"
MODEL_PATH=""  # 模型部署于 Pulsar 平台，无本地路径
TOKENIZER="/mnt/ai-llm/agent2-checkpoint-778"

# ── 数据处理 ──────────────────────────────────────────────────
DATA_FORMAT="standard"
INPUT_JSONL="/mnt/ai-infra/datasets/used4evaluation/xinghan-tarot-72b-agentv1/xinghan-tarot-72b-agentv1_2025-08-04_08-10.jsonl"
OUTPUT_DIR="datas/output_tarot"
MODEL_LIST="xinghan-tarot-72b-agentv1"
DATASET_PATH="datas/output_tarot/xinghan-tarot-72b-agentv1_selected_combined_3days_lowpeak_poisson_120_stitched.csv"
DATASET_TYPE="peak"

# ── Benchmark 公共参数 ─────────────────────────────────────────
SERVER_URL="https://infer-test.geniuworks.com/demo-xinghan-tarot-p72b-agentv1-jyf/v1/chat/completions"
GROUP_NAME="xinghan-tarot-72b-agentv1"
MAX_COMPLETION_TOKENS=1024     # 非推理型对话模型，avg_output ≈ 200 tokens
COOLDOWN_SECS=60

# ── QPS Sweep 参数（待确定容量范围后填写）─────────────────────
QPS_START=0.5
QPS_END=5.0
NUM_LEVELS=10
DURATION=1200

# ── Replay 参数 ────────────────────────────────────────────────
# 数据集：3天低峰期（04:00~05:00）拼接，14,732 条，avg 81.9 RPM，peak 120 RPM
# 选用低峰期原因：凌晨高峰 ~971 RPM 为全服务总负载，单实例 demo 不适合压测至此
# 回放将按 income_time 自然速率重放，持续约 180 分钟（3段×60分钟）
REPLAY_DATASET_PATH="datas/output_tarot/xinghan-tarot-72b-agentv1_demo20min.csv"
REPLAY_RPM="120"
